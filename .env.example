# Bu faylni ".env" deb nusxalang va o'zingizning kalitingizni yozing.
# .env faylini hech qachon GitHub'ga yoki zipga qo'shmang!

# Google AI Studio dan olingan Gemini API kaliti (majburiy)
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.0-flash

# --- Veb-server (portfolio) uchun ---
# Live Server ishlatilsa (VS Code): 5500 port
ALLOWED_ORIGINS=http://127.0.0.1:5500,http://localhost:5500,http://127.0.0.1:8000,http://localhost:8000

# Mehmon xabar qoldirsa Telegram'ga kelsin (ixtiyoriy)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Mehmon savollarini server/questions.log ga yozish
LOG_QUESTIONS=false

# Internetga ochishda: HOST=0.0.0.0  PORT=8000
HOST=127.0.0.1
PORT=8000
